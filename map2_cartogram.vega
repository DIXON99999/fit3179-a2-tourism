{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "width": 600,
  "height": 440,
  "title": {
    "text": "Sydney and Melbourne hold a third of Australia's people",
    "subtitle": "Each circle is a tourism region, sized by how many people live there (2025), placed as close to its real position as possible.",
    "anchor": "start",
    "offset": 10
  },
  "data": {
    "url": "data/cartogram_regions.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              80,
              600
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          },
          "axis": null
        },
        "size": {
          "field": "population",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              5201875
            ],
            "range": [
              0,
              4072
            ]
          },
          "legend": {
            "title": "People living there",
            "orient": "top-left",
            "values": [
              100000,
              1000000,
              5000000
            ],
            "format": ",.0f",
            "direction": "horizontal"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "Western Australia",
              "South Australia",
              "Tasmania",
              "Australian Capital Territory",
              "Northern Territory"
            ],
            "range": [
              "#0072B2",
              "#D55E00",
              "#009E73",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#7a7a7a",
              "#a6761d"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom-left",
            "columns": 2
          }
        },
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.region == 'Sydney' || datum.region == 'Melbourne'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              80,
              600
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "region",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.region == 'Destination Perth' || datum.region == 'Adelaide'"
        },
        {
          "calculate": "datum.y - datum.radius_px - 8",
          "as": "label_y"
        },
        {
          "calculate": "datum.region == 'Destination Perth' ? 'Perth' : datum.region",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              80,
              600
            ]
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.region == 'Brisbane'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222",
        "align": "left",
        "dx": 28
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              80,
              600
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "region",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "background": "white",
  "width": 520,
  "height": 420,
  "padding": 5,
  "title": {
    "text": "Queensland spreads its tourism money wide; Western Australia keeps 70% in Perth",
    "subtitle": "Each rectangle is a tourism region, sized by spend in 2024-25. Brisbane takes 38% of Queensland's total; Perth takes 70% of WA's.",
    "anchor": "start",
    "offset": 10,
    "subtitleFontSize": 12,
    "fontSize": 15
  },
  "data": [
    {
      "name": "tree",
      "url": "data/treemap_nodes.csv",
      "format": {
        "type": "csv",
        "parse": {
          "id": "number",
          "parent": "number",
          "value": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.2,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 1,
          "paddingOuter": 2
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "states",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "Western Australia",
        "South Australia",
        "Tasmania",
        "Australian Capital Territory",
        "Northern Territory"
      ],
      "range": [
        "#0072B2",
        "#D55E00",
        "#009E73",
        "#CC79A7",
        "#E69F00",
        "#56B4E9",
        "#7a7a7a",
        "#a6761d"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 0.5
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "state"
          },
          "fillOpacity": {
            "value": 0.9
          },
          "tooltip": {
            "signal": "{'Region': datum.name, 'State': datum.state, 'Spend ($m)': format(datum.value, ',.0f')}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 90 && (datum.y1 - datum.y0) > 30 ? datum.name : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 + 15"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "signal": "((datum.x1 - datum.x0) > 90 && (datum.y1 - datum.y0) > 40) ? (datum.name == 'Destination Perth' ? '70% of WA spend' : datum.name == 'Brisbane' ? '38% of Qld spend' : datum.name == 'Sydney' ? '55% of NSW spend' : datum.name == 'Melbourne' ? '65% of Vic spend' : datum.name == 'Gold Coast' ? '21% of Qld spend' : '') : ''"
          }
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "State",
      "orient": "right",
      "symbolType": "square",
      "symbolSize": 120
    }
  ]
}